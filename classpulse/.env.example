# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/classpulse?schema=public"

# Long random string used to sign login sessions (openssl rand -base64 32). Required in production.
AUTH_SECRET=""

# Public base URL of the app (used for the Paystack redirect). No trailing slash.
APP_URL="http://localhost:3000"

# Paystack secret key (Dashboard > Settings > API Keys). Use the sk_test_ key while testing.
# Online payment is switched off when this is empty. Never expose it to the browser.
PAYSTACK_SECRET_KEY=""

# Set to 1 only when the app is behind a reverse proxy you control (nginx, Vercel, etc.).
# Then X-Forwarded-For / X-Real-IP are trusted for per-IP rate limiting. Default: not trusted.
TRUST_PROXY="0"

# Optional Redis-backed rate limiting via Upstash REST. Leave empty to use in-memory counters.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional email for self-service password reset (Resend). Without a key, development
# prints the reset link to the console and returns it in the API response for local testing.
RESEND_API_KEY=""
EMAIL_FROM="Acumen Schools Portal <onboarding@resend.dev>"
